{
	"name": "genge",
	"type": "module",
	"displayName": "GENGE",
	"description": "👾 GENGE - The game engine's node graph editor is an extension that enables game creation across various engines (currently Godot) without coding, using visual scripting instead for 💠 VSCode.",
	"version": "0.8.75",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/genge-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/genge#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/genge"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/genge/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"genge",
		"game programming",
		"node graph editor",
		"game engine",
		"visual script",
		"godot",
		"godot editor",
		"vscode extension",
		"developer tools"
	],
	"categories": [
		"Visualization",
		"Other"
	],
	"galleryBanner": {
		"color": "#1B3A2F",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onLanguage:gdscript",
		"onCommand:genge.openEditor"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "genge.openEditor",
				"title": "GENGE: Open Visual Script Editor",
				"icon": "$(type-hierarchy)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "genge.openEditor",
					"when": "resourceExtname == .gd",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "GENGE",
			"properties": {
				"genge.godotPath": {
					"type": "string",
					"default": "",
					"description": "Path to the Godot executable (for validation and export)."
				},
				"genge.outputDir": {
					"type": "string",
					"default": "res://scripts/generated",
					"description": "Where generated GDScript files are saved."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown src/extension.ts --external vscode",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@types/node": "^20.0.0",
		"@types/three": "^0.186.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"typescript": "^5.3.0",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	},
	"dependencies": {
		"litegraph.js": "^0.7.18",
		"three": "^0.186.0"
	}
}